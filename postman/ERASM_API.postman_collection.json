        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Save the returned JWT into a collection variable so every",
                  "// other request is authenticated automatically.",
                  "if (pm.response.code === 200) {",
                  "    var token = pm.response.text();",
                  "    pm.collectionVariables.set('jwt', token);",
                  "    console.log('JWT saved to collection variable.');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@erasm.com\",\n  \"password\": \"password1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Authenticate. On 200, the JWT is auto-saved to {{jwt}}."
          },
          "response": []
        },
        {
